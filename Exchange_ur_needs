<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Swipe</title>
<style>
  :root {
    --bg: #f2f2f7; --card: #fff; --text: #111; --muted: #666;
    --line: #e5e5ea; --accent: #34c759; --danger: #ff3b30;
    --chat-theirs: #eee; --shadow: 0 8px 24px rgba(0,0,0,.12);
  }
  body.dark {
    --bg: #0e0e11; --card: #1c1c1f; --text: #f2f2f7; --muted: #9a9aa2;
    --line: #2c2c32; --chat-theirs: #2a2a30; --shadow: 0 8px 24px rgba(0,0,0,.5);
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body { margin: 0; padding: 0; height: 100%; overscroll-behavior: none; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    background: var(--bg); color: var(--text);
    display: flex; flex-direction: column; align-items: center;
    padding: 16px; overflow: hidden;
    transition: background .25s ease, color .25s ease;
  }
  .topbar {
    width: 100%; max-width: 340px; display: flex; align-items: center;
    justify-content: space-between; margin-bottom: 12px; min-height: 34px;
  }
  #title { font-size: 22px; font-weight: 700; margin: 0; }
  .theme-btn {
    width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--line);
    background: var(--card); color: var(--text); font-size: 15px; cursor: pointer;
    display: grid; place-items: center; transition: transform .15s ease;
  }
  .theme-btn:active { transform: scale(.9); }
  .stage { position: relative; width: 100%; max-width: 340px; height: 440px; touch-action: none; }
  .card {
    position: absolute; inset: 0; z-index: 1; background: var(--card);
    border-radius: 20px; overflow: hidden; box-shadow: var(--shadow);
    display: flex; flex-direction: column; touch-action: none;
    user-select: none; -webkit-user-select: none; cursor: grab;
    backface-visibility: hidden; will-change: transform;
  }
  .card:active { cursor: grabbing; }
  .card.behind {
    z-index: 0; transform: translateY(14px) scale(.94);
    pointer-events: none; box-shadow: 0 4px 14px rgba(0,0,0,.08);
  }
  .card.gone-left  { transform: translateX(-150%) rotate(-20deg); opacity: 0; }
  .card.gone-right { transform: translateX(150%)  rotate(20deg);  opacity: 0; }
  .card.gone-up    { transform: translateY(-160%) scale(1.05);    opacity: 0; }
  .card img {
    width: 100%; height: 290px; object-fit: cover; display: block;
    background: var(--line); pointer-events: none; -webkit-user-drag: none;
  }
  .info { padding: 14px 18px; pointer-events: none; }
  .name { font-size: 21px; font-weight: 700; }
  .bio  { color: var(--muted); font-size: 14px; margin-top: 6px; line-height: 1.4; }
  .stamp {
    position: absolute; top: 26px; padding: 6px 14px; border-radius: 8px;
    font-size: 22px; font-weight: 800; letter-spacing: 1px; border: 3px solid;
    opacity: 0; pointer-events: none;
  }
  .stamp-yes  { left: 20px;  color: var(--accent); border-color: var(--accent); transform: rotate(-15deg); }
  .stamp-no   { right: 20px; color: var(--danger); border-color: var(--danger); transform: rotate(15deg); }
  .stamp-super {
    left: 50%; top: 40%; transform: translate(-50%,-50%) rotate(-12deg);
    color: #0a84ff; border-color: #0a84ff;
  }
  .buttons { display: flex; gap: 18px; justify-content: center; margin-top: 16px; }
  .btn {
    width: 64px; height: 64px; border-radius: 50%; border: none; font-size: 24px;
    cursor: pointer; background: var(--card); box-shadow: 0 4px 12px rgba(0,0,0,.12);
    transition: transform .1s ease;
  }
  .btn:active { transform: scale(.9); }
  .btn.pass  { color: var(--danger); }
  .btn.like  { color: var(--accent); }
  .btn.super { color: #0a84ff; width: 52px; height: 52px; font-size: 19px; align-self: center; }
  .match-screen {
    width: 100%; max-width: 340px; border-radius: 20px; padding: 36px 20px;
    text-align: center; color: #fff;
    background: linear-gradient(160deg, #ff5f6d, #ffb347);
    box-shadow: 0 12px 30px rgba(255,95,109,.35);
    animation: pop .3s ease both;
  }
  @keyframes pop { from { transform: scale(.9); opacity: 0; } }
  .match-screen .big { font-size: 52px; }
  .match-screen h3 { font-size: 25px; margin: 10px 0 6px; }
  .match-screen p { margin: 0 0 20px; opacity: .95; font-size: 15px; }
  .wide {
    width: 100%; padding: 13px; border-radius: 30px; border: none;
    font-size: 16px; font-weight: 600; cursor: pointer; margin: 5px 0;
  }
  .white-btn { background: #fff; color: #ff5f6d; }
  .ghost-btn { background: rgba(255,255,255,.28); color: #fff; }
  .chat { width: 100%; max-width: 340px; }
  .chat-head {
    font-weight: 700; margin-bottom: 10px; font-size: 17px;
    display: flex; justify-content: space-between; align-items: center;
  }
  .back { background: none; border: none; color: var(--danger); font-size: 15px; cursor: pointer; }
  .msgs {
    background: var(--card); border-radius: 16px; padding: 12px; height: 300px;
    overflow-y: auto; display: flex; flex-direction: column; gap: 8px;
    box-shadow: var(--shadow);
  }
  .msg {
    max-width: 78%; padding: 9px 13px; border-radius: 16px; font-size: 14px;
    line-height: 1.35; animation: msgIn .2s ease both; word-wrap: break-word;
  }
  @keyframes msgIn { from { transform: translateY(6px); opacity: 0; } }
  .mine   { align-self: flex-end;   background: var(--accent); color: #fff; border-bottom-right-radius: 4px; }
  .theirs { align-self: flex-start; background: var(--chat-theirs); color: var(--text); border-bottom-left-radius: 4px; }
  .typing { align-self: flex-start; color: var(--muted); font-size: 13px; padding: 4px 8px; }
  .row { display: flex; gap: 8px; margin-top: 10px; }
  .row input {
    flex: 1; padding: 12px 16px; border-radius: 24px; border: 1px solid var(--line);
    background: var(--card); color: var(--text); font-size: 15px; outline: none; min-width: 0;
  }
  .send {
    padding: 0 20px; border-radius: 24px; border: none; background: var(--accent);
    color: #fff; font-size: 15px; font-weight: 600; cursor: pointer;
  }
  .done { text-align: center; color: var(--muted); padding: 20px 16px; }
  .done strong { color: var(--text); }
  .done .stat { font-size: 13px; margin: 4px 0 14px; }
  .chatlink {
    display: block; width: 100%; text-align: left; background: var(--card);
    border: none; box-shadow: var(--shadow); border-radius: 12px;
    padding: 13px 15px; margin-bottom: 8px; font-size: 15px;
    color: var(--text); cursor: pointer;
  }
  .empty { text-align: center; color: var(--muted); padding: 24px 8px; font-size: 14px; }
</style>
</head>
<body>

<div class="topbar">
  <h2 id="title">Find Someone</h2>
  <button class="theme-btn" onclick="toggleTheme()" id="themeBtn">🌙</button>
</div>

<div id="app"></div>

<script>
/* v3 — your own photo in the first card */
const VERSION = "v3";
const SAVE_KEY = "swipeAppState_" + VERSION;
const THEME_KEY = "swipeTheme";

const profiles = [
  {
    name: "Ananya, 24",
    bio: "Pink outfits, long drives, and good coffee. Swipe right if you can keep up.",
    img: "https://i.postimg.cc/0NPwh34M/IMG20261106151515.jpg",
    likesYou: true
  },
  { name: "Arjun, 29", bio: "Weekend trekker. I make a mean pasta. Bad at texting, good at showing up.", img: "https://i.pravatar.cc/600?img=12", likesYou: false },
  { name: "Sneha, 24", bio: "Designer. Plant mom. Will judge you for your Spotify wrapped.",                  img: "https://i.pravatar.cc/600?img=32", likesYou: true  },
  { name: "Rahul, 31", bio: "Software guy trying to be interesting. Ask me about my sourdough.",               img: "https://i.pravatar.cc/600?img=15", likesYou: false },
  { name: "Meera, 27", bio: "Doctor by day, dancer by night. Dog person, obviously.",                          img: "https://i.pravatar.cc/600?img=47", likesYou: true  }
];

let index = 0;
let liked = [];
let matches = [];
let chats = {};
let superUsed = false;

const app = document.getElementById("app");
const title = document.getElementById("title");
const themeBtn = document.getElementById("themeBtn");

function save() {
  try { localStorage.setItem(SAVE_KEY, JSON.stringify({ index, liked, matches, chats, superUsed })); } catch (e) {}
}

function load() {
  try {
    const raw = localStorage.getItem(SAVE_KEY);
    if (!raw) return;
    const s = JSON.parse(raw);
    index = typeof s.index === "number" ? s.index : 0;
    liked = Array.isArray(s.liked) ? s.liked : [];
    matches = Array.isArray(s.matches) ? s.matches.filter(Boolean) : [];
    chats = s.chats && typeof s.chats === "object" ? s.chats : {};
    superUsed = !!s.superUsed;
  } catch (e) {
    index = 0; liked = []; matches = []; chats = {}; superUsed = false;
  }
}

function applyTheme() {
  let dark = false;
  try { dark = localStorage.getItem(THEME_KEY) === "dark"; } catch (e) {}
  document.body.classList.toggle("dark", dark);
  themeBtn.textContent = dark ? "☀️" : "🌙";
}

function toggleTheme() {
  const dark = !document.body.classList.contains("dark");
  document.body.classList.toggle("dark", dark);
  themeBtn.textContent = dark ? "☀️" : "🌙";
  try { localStorage.setItem(THEME_KEY, dark ? "dark" : "light"); } catch (e) {}
}

function renderSwipe() {
  title.textContent = "Find Someone";

  if (index >= profiles.length) {
    app.innerHTML = `
      <div class="done">
        <p>That's everyone for now.</p>
        <p class="stat">You liked ${liked.length} · <strong>${matches.length} match${matches.length === 1 ? "" : "es"}</strong></p>
        ${matches.map((m, i) => `<button class="chatlink" onclick="openChat(${i})">💬 ${m.name.split(",")[0]}</button>`).join("")}
        <div class="buttons"><button class="btn" onclick="restart()">↻</button></div>
      </div>`;
    return;
  }

  const p = profiles[index];
  const next = profiles[index + 1];

  app.innerHTML = `
    <div class="stage">
      ${next ? `
        <div class="card behind">
          <img src="${next.img}" alt="" draggable="false">
          <div class="info">
            <div class="name">${next.name}</div>
            <div class="bio">${next.bio}</div>
          </div>
        </div>` : ""}
      <div class="card" id="card">
        <img src="${p.img}" alt="" draggable="false">
        <div class="stamp stamp-yes" id="stampYes">LIKE</div>
        <div class="stamp stamp-no"  id="stampNo">NOPE</div>
        <div class="stamp stamp-super" id="stampSuper">SUPER</div>
        <div class="info">
          <div class="name">${p.name}</div>
          <div class="bio">${p.bio}</div>
        </div>
      </div>
    </div>
    <div class="buttons">
      <button class="btn pass" onclick="swipe(false)">✕</button>
      <button class="btn super" onclick="swipe('super')" ${superUsed ? "disabled style='opacity:.35'" : ""}>⭐</button>
      <button class="btn like" onclick="swipe(true)">♥</button>
    </div>`;

  enableDrag();
}

function enableDrag() {
  const card = document.getElementById("card");
  const yes  = document.getElementById("stampYes");
  const no   = document.getElementById("stampNo");
  const sup  = document.getElementById("stampSuper");
  if (!card) return;

  let startX = 0, startY = 0, dx = 0, dy = 0;
  let dragging = false, moved = false;

  function reset() {
    card.style.transition = "transform .3s ease, opacity .3s ease";
    card.style.transform = "";
    yes.style.opacity = 0;
    no.style.opacity = 0;
    sup.style.opacity = 0;
    dx = 0; dy = 0;
  }

  card.addEventListener("pointerdown", e => {
    if (card.dataset.done) return;
    dragging = true; moved = false;
    startX = e.clientX; startY = e.clientY;
    dx = 0; dy = 0;
    card.style.transition = "none";
  });

  card.addEventListener("pointermove", e => {
    if (!dragging || card.dataset.done) return;
    dx = e.clientX - startX;
    dy = e.clientY - startY;
    if (Math.abs(dx) < 6 && Math.abs(dy) < 6) return;
    moved = true;
    e.preventDefault();

    if (!superUsed && dy < -40 && Math.abs(dy) > Math.abs(dx) * 1.4) {
      card.style.transform = `translateY(${dy}px)`;
      sup.style.opacity = Math.min(1, Math.max(0, -dy / 120));
      yes.style.opacity = 0;
      no.style.opacity = 0;
      return;
    }

    if (Math.abs(dx) > Math.abs(dy)) {
      card.style.transform = `translate(${dx}px, ${dy / 4}px) rotate(${dx / 18}deg)`;
      yes.style.opacity = Math.min(1, Math.max(0,  dx / 100));
      no.style.opacity  = Math.min(1, Math.max(0, -dx / 100));
      sup.style.opacity = 0;
    }
  });

  card.addEventListener("pointerup", () => {
    if (!dragging) return;
    dragging = false;
    if (card.dataset.done) return;

    if (dx > 90)       swipe(true);
    else if (dx < -90) swipe(false);
    else if (!superUsed && dy < -110) swipe("super");
    else if (moved)    reset();
  });

  card.addEventListener("pointercancel", reset);
}

function swipe(kind) {
  const p = profiles[index];
  const card = document.getElementById("card");
  if (!card || card.dataset.done) return;

  card.dataset.done = "1";
  card.style.transition = "transform .35s ease, opacity .35s ease";

  if (kind === "super") {
    card.classList.add("gone-up");
    superUsed = true;
  } else {
    card.classList.add(kind ? "gone-right" : "gone-left");
  }

  setTimeout(() => {
    const isSuper = kind === "super";
    if (kind === true || isSuper) {
      if (!liked.includes(p.name)) liked.push(p.name);
    }

    if (isSuper || (kind === true && p.likesYou)) {
      const exists = matches.filter(m => m && m.name === p.name).length > 0;
      if (!exists) {
        matches.push(p);
        if (!chats[p.name]) {
          chats[p.name] = [{ from: "them", text: isSuper ? "A super like? Okay, I'm flattered 😳" : "Hey! We matched 😊" }];
        }
      }
      save();
      showMatch(p, isSuper);
      return;
    }

    index++;
    save();
    renderSwipe();
  }, 340);
}

function showMatch(p, isSuper) {
  title.textContent = "";
  app.innerHTML = `
    <div class="match-screen">
      <div class="big">${isSuper ? "⭐" : "💚"}</div>
      <h3>${isSuper ? "Super Liked!" : "It's a Match!"}</h3>
      <p>You and ${p.name.split(",")[0]} like each other</p>
      <button class="wide white-btn" onclick="continueSwiping()">Keep Swiping</button>
      <button class="wide ghost-btn" onclick="openChatByName('${p.name.replace(/'/g, "\\'")}')">Send a message</button>
    </div>`;
}

function continueSwiping() {
  index++;
  save();
  renderSwipe();
}

function openChatByName(name) {
  const i = matches.findIndex(m => m && m.name === name);
  openChat(i);
}

function openChat(i) {
  const m = matches[i];
  if (!m) { renderSwipe(); return; }
  const name = m.name;

  title.textContent = "Messages";
  const msgs = chats[name] || [];

  app.innerHTML = `
    <div class="chat">
      <div class="chat-head">
        <span>${name}</span>
        <button class="back" onclick="renderSwipe()">← Back</button>
      </div>
      <div class="msgs" id="msgs">
        ${msgs.length
          ? msgs.map(x => `<div class="msg ${x.from === "me" ? "mine" : "theirs"}">${x.text}</div>`).join("")
          : `<div class="empty">Say hi 👋</div>`}
      </div>
      <div class="row">
        <input id="inp" placeholder="Type a message…" onkeydown="if(event.key==='Enter')send(${i})">
        <button class="send" onclick="send(${i})">Send</button>
      </div>
    </div>`;

  scrollDown();
}

function scrollDown() {
  const box = document.getElementById("msgs");
  if (box) box.scrollTop = box.scrollHeight;
}

function send(i) {
  const m = matches[i];
  if (!m) return;
  const name = m.name;

  const inp = document.getElementById("inp");
  if (!inp) return;
  const text = inp.value.trim();
  if (!text) return;

  if (!chats[name]) chats[name] = [];
  chats[name].push({ from: "me", text });
  save();
  openChat(i);

  setTimeout(() => {
    const box = document.getElementById("msgs");
    if (box && title.textContent === "Messages") {
      box.insertAdjacentHTML("beforeend", `<div class="typing">typing…</div>`);
      scrollDown();
    }
    setTimeout(() => {
      const replies = [
        "Haha that's funny 😄",
        "So what do you do on weekends?",
        "Tell me more!",
        "Same here honestly",
        "We should grab coffee sometime ☕",
        "Wait, really? 😂",
        "Okay you have my attention"
      ];
      if (!chats[name]) chats[name] = [];
      chats[name].push({ from: "them", text: replies[Math.floor(Math.random() * replies.length)] });
      save();
      if (title.textContent === "Messages") openChat(i);
    }, 900);
  }, 350);
}

function restart() {
  index = 0; liked = []; matches = []; chats = {}; superUsed = false;
  try { localStorage.removeItem(SAVE_KEY); localStorage.removeItem("swipeAppState_v2"); localStorage.removeItem("swipeAppState"); } catch (e) {}
  renderSwipe();
}

applyTheme();
load();
renderSwipe();
</script>

</body>
</html>
